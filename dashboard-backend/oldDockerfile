# Use official Node.js 22 image
FROM node:22.15.1-slim AS base

# Set working directory
WORKDIR /app

# Install OpenSSL (and other dependencies Prisma may need)
RUN apt-get update -y && \
    apt-get install -y openssl libssl-dev curl && \
    rm -rf /var/lib/apt/lists/*

# Copy package files first for caching dependencies
COPY package*.json ./

# Install only production dependencies (if you have dev dependencies, use a build stage)
RUN npm install --omit=dev

# Copy application source
COPY . .

RUN npx prisma generate

# Expose backend port (adjust if your backend runs on another port)
EXPOSE 3300

# Start backend
CMD ["npm", "start"]

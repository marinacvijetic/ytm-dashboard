generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientApplication {
  client_id            Int        @id @default(autoincrement())
  app_id               String?    @unique
  app_title            String?
  version              String?
  url                  String?
  api_url              String?
  created_at           DateTime?  @db.Timestamp(6)
  last_update          DateTime?  @db.Timestamp(6)
  proctor_edu          Boolean?   @default(false)
  proctorio            Boolean?   @default(false)
  superset_apache      Boolean?   @default(false)
  last_ping_at         DateTime?  @db.Timestamp(6)
  last_ping_successful Boolean?   @default(false)
  is_active            Boolean?   @default(false)
  services             services[]

  @@map("client_applications")
}

model services {
  id                  String            @id
  app_id              String
  type                String            @db.VarChar(50)
  last_ping           DateTime?         @db.Timestamp(6)
  status              String?           @db.VarChar(20)
  client_applications ClientApplication @relation(fields: [app_id], references: [app_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_client_app_services_app_id")
}


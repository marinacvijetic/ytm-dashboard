generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientApplication {
  client_id     Int                 @id         @default(autoincrement())            
  app_id        String?             @unique
  app_name      String?
  version       String?
  url           String?
  created_at    DateTime?           @default(now())
  last_update   DateTime?           @updatedAt
  services       ClientAppService[]

  @@map("client_applications")
}

model ClientAppService {
  service_id      Int                 @id    @default(autoincrement())               
  client_id       Int
  service_name     String?
  ip_address      String?
  status          String?
  last_heartbeat  DateTime?           @default(now())
  is_main         Boolean             @default(false)
  melody          String?
  system_info     Json?               @db.JsonB
  client          ClientApplication   @relation(fields: [client_id], references: [client_id], onDelete: Cascade)

  @@unique([client_id, service_name])
  @@map("client_app_services")
}
